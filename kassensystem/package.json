{
  "name": "kassensystem",
  "version": "1.0.0",
  "description": "Kassensystem mit Wertbon-Druck für Dobelmühle-Feste",
  "main": "./out/main/index.js",
  "author": "Dobelmühle gGmbH",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "electron-rebuild -f -w better-sqlite3,usb,serialport",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "start": "electron-vite preview",
    "prestart": "electron-rebuild -f -w better-sqlite3,usb,serialport",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "pretest": "npm rebuild better-sqlite3 usb serialport",
    "rebuild": "electron-rebuild",
    "dist:win": "npm run build && electron-builder --win",
    "predist:win": "electron-rebuild -f -w better-sqlite3,usb,serialport",
    "dist:linux": "npm run build && electron-builder --linux",
    "predist:linux": "electron-rebuild -f -w better-sqlite3,usb,serialport",
    "dist:mac": "npm run build && electron-builder --mac",
    "predist:mac": "electron-rebuild -f -w better-sqlite3,usb,serialport"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "node-thermal-printer": "^4.6.0",
    "serialport": "^13.0.0",
    "usb": "^3.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron@43.1.1": true,
    "@serialport/bindings-cpp@13.0.0": true
  }
}
